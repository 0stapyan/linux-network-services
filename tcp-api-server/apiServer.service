[Unit]
Description=TCP API server with a custom protocol (port 4242)
After=network-online.target
Wants=network-online.target

[Service]
# socat accepts connections and starts a separate apiServer.sh process for each client
ExecStart=/usr/bin/socat TCP4-LISTEN:4242,reuseaddr,fork EXEC:/usr/bin/apiServer.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
